{
  "name": "terminal-electron",
  "version": "0.1.0",
  "description": "[placeholder copy: Electron apps that render into your terminal pane]",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "terminal-electron": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "default": "./dist/terminal/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "scripts/apparmor.sh"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "electron": "43.3.0",
    "react-reconciler": "^0.29.2"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "@terminal-electron/native-darwin-arm64": "workspace:*",
    "@terminal-electron/native-darwin-x64": "workspace:*",
    "@terminal-electron/native-linux-arm64": "workspace:*",
    "@terminal-electron/native-linux-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-reconciler": "^0.28.8",
    "react": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
